OPENROUTER_API_KEY=
SERPER_API_KEY=

# defaults shown; override if you want a different model or search fan-out
DEFAULT_MODEL_NAME=openai/gpt-4.1-mini
HOW_MANY_SEARCHES=5

# USE_EMAIL=true sends a real email via EMAIL_* below; set to false to get a Pushover push instead
USE_EMAIL=true
EMAIL_ADDRESS=
EMAIL_SMTP_SERVER=
EMAIL_APP_PASSWORD=

# only needed if USE_EMAIL=false
PUSHOVER_USER=
PUSHOVER_TOKEN=
